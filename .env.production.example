# Production Environment Configuration
# Copy this file to .env.production and fill in your values
# Deploy with: docker-compose -f docker-compose.prod.yml --env-file .env.production up -d

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here_change_this
POSTGRES_DB=finance_agent
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here_change_this@db:5432/finance_agent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_PASSWORD=your_redis_password_here_change_this
REDIS_URL=redis://:your_redis_password_here_change_this@redis:6379/0

# ==========================================
# VECTOR DATABASE (Qdrant)
# ==========================================
VECTOR_DB_URL=http://qdrant:6333
VECTOR_COLLECTION_NAME=documents

# ==========================================
# LLM CONFIGURATION (DeepSeek, OpenAI-compatible)
# ==========================================
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
# Alternative models: deepseek-chat, deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ==========================================
# EMBEDDING CONFIGURATION
# ==========================================
# Options: local (FREE), openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=bge-m3-v2-zh
# Alternative local models: bge-m3, bge-large-zh-v1.5
# For glm provider: embedding-2, embedding-3
# For openai provider: text-embedding-3-small, text-embedding-ada-002

# ==========================================
# MEMORY CONFIGURATION
# ==========================================
# Options: sliding_window, optimized, hybrid, summarization
MEMORY_TYPE=optimized
MEMORY_MAX_RECENT=3
MEMORY_MAX_RELEVANT=5
MEMORY_RELEVANCE_THRESHOLD=0.5
MEMORY_TOKEN_BUDGET=4096

# ==========================================
# APPLICATION SETTINGS
# ==========================================
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=your_secret_key_generate_with_openssl_rand_hex_32
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=10

# ==========================================
# FINANCIAL COMPLIANCE & GUARDRAILS
# ==========================================
GUARDRAILS_ENABLED=true
GUARDRAILS_INPUT_ENABLED=true
GUARDRAILS_OUTPUT_ENABLED=true
GUARDRAILS_PII_REDACTION_ENABLED=true
# PII mask style: full ([REDACTED]) or partial (keep last 4 digits)
PII_MASK_STYLE=full
# Block return-promise language (保本/稳赚) in LLM output
COMPLIANCE_CHECK_ENABLED=true
# Append risk disclaimer to investment-related responses
RISK_DISCLAIMER_ENABLED=true

# ==========================================
# AUDIT LOGGING
# ==========================================
AUDIT_LOG_ENABLED=true

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ==========================================
# SECURITY
# ==========================================
# Generate secure secret key with: openssl rand -hex 32
# SECRET_KEY should be at least 32 characters long

# JWT Configuration (if authentication is enabled)
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# ==========================================
# DEPLOYMENT SETTINGS
# ==========================================
# Domain for SSL certificate
DOMAIN=yourdomain.com
LETSENCRYPT_EMAIL=your_email@example.com

# ==========================================
# OPTIONAL: OPENAI CONFIGURATION
# ==========================================
# Only needed if using OpenAI for embeddings or LLM
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4-turbo-preview

# ==========================================
# OPTIONAL: ANTHROPIC CONFIGURATION
# ==========================================
# Only needed if using Anthropic Claude for LLM
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# ==========================================
# BACKUP CONFIGURATION
# ==========================================
# Automated database backup settings
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7
BACKUP_TIME=02:00
