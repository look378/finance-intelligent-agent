# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finance_agent
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Vector DB Service (external)
VECTOR_DB_URL=http://localhost:6333
VECTOR_COLLECTION_NAME=documents
VECTOR_API_KEY=

# LLM Providers
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
# DeepSeek OpenAI-compatible API base URL
DEEPSEEK_BASE_URL=https://api.deepseek.com

OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229

# Embedding Models
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=bge-m3-v2-zh
EMBEDDING_CACHE_TTL=604800
EMBEDDING_DEVICE=cpu

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Memory Management (Optimized context with relevance filtering)
MEMORY_TYPE=optimized
MEMORY_MAX_RECENT=3
MEMORY_MAX_RELEVANT=5
MEMORY_RELEVANCE_THRESHOLD=0.5
MEMORY_TOKEN_BUDGET=4096

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Guardrails & Compliance (financial)
GUARDRAILS_ENABLED=true
GUARDRAILS_INPUT_ENABLED=true
GUARDRAILS_OUTPUT_ENABLED=true
GUARDRAILS_PII_REDACTION_ENABLED=true
PII_MASK_STYLE=full            # full ([REDACTED]) | partial (keep last 4 digits)
COMPLIANCE_CHECK_ENABLED=true  # block return-promise language in output
RISK_DISCLAIMER_ENABLED=true   # append risk disclaimer to investment responses

# Audit Logging
AUDIT_LOG_ENABLED=true

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30.0

# GraphRAG Features
GRAPH_RAG_ENABLED=false
GRAPH_RAG_EXTRACTION_ENABLED=true
GRAPH_RAG_COMMUNITY_ENABLED=false
GRAPH_RAG_COMMUNITY_MIN_SIZE=3
GRAPH_RAG_COMMUNITY_MAX_LEVELS=5
GRAPH_RAG_FUSION_WEIGHT=0.5
GRAPH_RAG_TEXT_TO_CYPHER_ENABLED=true
GRAPH_RAG_MAX_HOPS=3

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false
OTEL_ENDPOINT=http://jaeger:4317
